---
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Turntable — Device mockup studio",
  description = "Create polished device mockups directly in the browser.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111113" />
    <meta name="description" content={description} />
    <script is:inline>
      if (window.matchMedia?.("(max-width: 900px)").matches) {
        document.documentElement.classList.add("mobile-panel-closed");
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
